{
  "app": {
    "bundleName": "com.edvinn.firstwearableapplication",
    "vendor": "example",
    "version": {
      "code": 1000003,
      "name": "1.0.3"
    }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": [
      "liteWearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "name": ".MainAbility",
        "srcLanguage": "js",
        "srcPath": "MainAbility",
        "icon": "$media:icon",
        "description": "$string:MainAbility_desc",
        "label": "$string:MainAbility_label",
        "type": "page"
      }
    ],
    "js": [
      {
        "pages": [
          "pages/index/index",
          "pages/nettest/nettest",
          "pages/p2p/p2p"
        ],
        "name": ".MainAbility"
      }
    ],
    "reqPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "usedScene": {
          "ability": [
            "MainAbility"
          ],
          "when": "always"
        },
        "reason": "$string:reqPermissions"
      }
    ]
  }
}
