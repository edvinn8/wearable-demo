<div class="page" onswipe="onSwipe">
    <list class="lst" ref="listRef">
        <list-item class="title-item">
            <text class="title">Mock UI</text>
        </list-item>
        <list-item for="{{ items }}" class="menu-item" onclick="open({{ $idx }})">
            <div class="menu-row">
                <text class="menu-icon">{{ $item.icon }}</text>
                <div class="menu-texts">
                    <text class="menu-label">{{ $item.label }}</text>
                    <text class="menu-sub">{{ $item.sub }}</text>
                </div>
            </div>
        </list-item>
        <list-item class="spacer"></list-item>
    </list>
</div>
