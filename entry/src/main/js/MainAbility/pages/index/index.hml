<div class="container">
    <progress class="progressArc" type="arc" percent="{{ progressNumber }}"></progress>
    <text class="progress-text">{{ progressNumber }}%</text>
    <input class="updateBtn" type="button" value="Positions" onclick="goPositions"></input>

    <input class="updateBtn" type="button" value="HTTP test" onclick="goNet"></input>
    <input class="updateBtn" type="button" value="P2P test" onclick="goP2p"></input>
    <text class="version-text">v1.0.4 — tools</text>
</div>
