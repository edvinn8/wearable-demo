<div class="page" onswipe="swipe">
    <list class="list" ref="listRef">
        <list-item class="heading">
            <text class="title">Lights</text>
            <text class="subtitle">{{ status }}</text>
        </list-item>
        <!-- Repeats over ids only; row values are read by index so a tap updates one row, not the list. -->
        <list-item for="{{ lightOrder }}" class="light">
            <div class="row">
                <div class="text">
                    <text class="name">{{ lights[$idx] ? lights[$idx].name : '' }}</text>
                    <text class="room">{{ lights[$idx] ? lights[$idx].line : '' }}</text>
                </div>
                <input class="toggle-on" type="button" value="{{ lights[$idx] ? lights[$idx].label : '' }}" show="{{ lights[$idx] ? lights[$idx].isOn : false }}" onclick="toggle({{ $idx }})"></input>
                <input class="toggle-off" type="button" value="{{ lights[$idx] ? lights[$idx].label : '' }}" show="{{ lights[$idx] ? lights[$idx].isOff : false }}" onclick="toggle({{ $idx }})"></input>
                <text class="toggle-other" show="{{ lights[$idx] ? lights[$idx].isOther : false }}">{{ lights[$idx] ? lights[$idx].label : '' }}</text>
            </div>
        </list-item>
        <list-item class="footer">
            <input class="refresh" type="button" value="Refresh" onclick="refresh"></input>
            <input class="back" type="button" value="Back" onclick="back"></input>
        </list-item>
        <list-item class="spacer"></list-item>
    </list>
</div>
