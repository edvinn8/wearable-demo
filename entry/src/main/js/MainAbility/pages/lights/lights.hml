<div class="page" onswipe="swipe">
    <list class="list" ref="listRef">
        <list-item class="heading">
            <text class="title">Lights</text>
            <text class="subtitle">{{ status }}</text>
        </list-item>
        <list-item for="{{ lights }}" class="light">
            <div class="row">
                <div class="text">
                    <text class="name">{{ $item.name }}</text>
                    <text class="room">{{ $item.line }}</text>
                </div>
                <input class="toggle-on" type="button" value="{{ $item.label }}" show="{{ $item.isOn }}" onclick="toggle({{ $idx }})"></input>
                <input class="toggle-off" type="button" value="{{ $item.label }}" show="{{ $item.isOff }}" onclick="toggle({{ $idx }})"></input>
                <text class="toggle-other" show="{{ $item.isOther }}">{{ $item.label }}</text>
            </div>
        </list-item>
        <list-item class="footer">
            <input class="refresh" type="button" value="Refresh" onclick="refresh"></input>
            <input class="back" type="button" value="Tools" onclick="back"></input>
        </list-item>
        <list-item class="spacer"></list-item>
    </list>
</div>
