<stack class="page" onswipe="onSwipe">
    <!-- Layer 1: the group's details, scrollable -->
    <list class="lst" ref="listRef">
        <list-item class="head-item">
            <text class="{{ sideClass }}">{{ title }}</text>
            <text class="{{ netClass }}">{{ netText }}</text>
            <text class="head-sub">{{ lotsText }}</text>
        </list-item>
        <list-item for="{{ facts }}" class="fact-item">
            <text class="fact-label">{{ $item.label }}</text>
            <text class="fact-value">{{ $item.value }}</text>
        </list-item>
        <list-item class="section-item">
            <text class="section">{{ layersTitle }}</text>
        </list-item>
        <list-item for="{{ layers }}" class="layer-item">
            <div class="layer">
                <text class="layer-no">{{ $item.no }}</text>
                <div class="layer-mid">
                    <text class="layer-entry">{{ $item.entry }}</text>
                    <text class="layer-sub">{{ $item.sub }}</text>
                </div>
                <text class="{{ $item.netClass }}">{{ $item.net }}</text>
            </div>
        </list-item>
        <list-item class="btn-item">
            <input class="btn btn-red" type="button" value="Close…" onclick="askClose"></input>
        </list-item>
        <list-item class="btn-item">
            <input class="btn btn-gray" type="button" value="Back" onclick="back"></input>
        </list-item>
        <list-item class="spacer"></list-item>
    </list>

    <!-- Layer 2: dimmed overlay with the two-step close, like /close in Telegram -->
    <div class="overlay" show="{{ overlay }}">
        <div class="sheet" show="{{ step1 }}">
            <text class="sheet-title">{{ confirmTitle }}</text>
            <text class="sheet-text">{{ confirmText }}</text>
            <input class="btn btn-red" type="button" value="Confirm" onclick="confirmClose"></input>
            <input class="btn btn-gray sheet-gap" type="button" value="Cancel" onclick="cancel"></input>
        </div>
        <div class="sheet" show="{{ step2 }}">
            <text class="spinner">◌</text>
            <text class="sheet-text">Closing at market…</text>
        </div>
        <div class="sheet" show="{{ step3 }}">
            <text class="done">✓</text>
            <text class="sheet-title">{{ resultTitle }}</text>
            <text class="sheet-text">{{ resultText }}</text>
            <input class="btn" type="button" value="Done" onclick="done"></input>
        </div>
    </div>
</stack>
