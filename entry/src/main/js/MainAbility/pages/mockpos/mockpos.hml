<div class="page" onswipe="onSwipe">
    <!-- Loading -->
    <div if="{{ isLoading }}" class="center">
        <text class="spinner">◌</text>
        <text class="center-text">Asking the phone…</text>
    </div>

    <!-- Phone unavailable / error / stopped-with-no-data -->
    <div elif="{{ isMessage }}" class="center">
        <text class="big-icon">{{ icon }}</text>
        <text class="center-text">{{ message }}</text>
        <input class="btn" type="button" value="Retry" onclick="retry"></input>
    </div>

    <!-- Data (ok, stale, stopped, empty) -->
    <list else class="lst" ref="listRef">
        <list-item class="head-item">
            <text class="head-label">{{ headLabel }}</text>
            <text class="head up" show="{{ netUp }}">{{ netText }}</text>
            <text class="head down" show="{{ netDown }}">{{ netText }}</text>
            <text class="head-sub">{{ headSub }}</text>
            <text class="badge" show="{{ hasBadge }}">{{ badge }}</text>
        </list-item>
        <list-item for="{{ rows }}" class="row-item" onclick="openGroup({{ $idx }})">
            <div class="row">
                <text class="side buy" show="{{ $item.buy }}">B</text>
                <text class="side sell" show="{{ $item.sell }}">S</text>
                <div class="row-mid">
                    <text class="sym">{{ $item.symbol }}</text>
                    <text class="lots">{{ $item.lots }}</text>
                </div>
                <text class="net up" show="{{ $item.up }}">{{ $item.net }}</text>
                <text class="net down" show="{{ $item.down }}">{{ $item.net }}</text>
            </div>
        </list-item>
        <list-item class="empty-item" show="{{ isEmpty }}">
            <text class="center-text">No open positions</text>
        </list-item>
        <list-item class="foot-item">
            <text class="foot">{{ foot }}</text>
        </list-item>
        <list-item class="btn-item">
            <input class="btn btn-gray" type="button" value="Refresh" onclick="retry"></input>
        </list-item>
        <list-item class="spacer"></list-item>
    </list>
</div>
